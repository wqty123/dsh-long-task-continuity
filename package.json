{
  "name": "dsh-long-task-continuity",
  "version": "0.2.4",
  "private": true,
  "description": "长期任务连续性与混合多代理框架：任务状态、执行权、检查点、交接与恢复（已装载到本机 web profile：D:\\dsh-home\\plugins）",
  "type": "module",
  "main": "./lib/src/index.js",
  "exports": {
    ".": {
      "default": "./lib/src/index.js"
    },
    "./client": "./client.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.example.yml": "./cordis.patch.example.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib/**",
    "client.js",
    "src/**",
    "vendor/**",
    "cordis.patch.example.yml",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "typecheck:all": "tsc -p tsconfig.check-all.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-agent": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-goal": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-session-title": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-storage": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-subagent": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-token-meter": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4",
    "zod": ">=4.4.3 <5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-goal": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    }
  },
  "keywords": [
    "dsh",
    "cordis",
    "long-task",
    "continuity",
    "handoff"
  ],
  "license": "MIT"
}
